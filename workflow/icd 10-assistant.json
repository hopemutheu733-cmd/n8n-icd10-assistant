    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst candidates = items.map(i => `${i.json.code}: ${i.json.description}`).join('\\n');\nconst codes = items.map(i => i.json.code);\nconst description = $('Webhook').first().json.body.description;\nreturn [{ json: { description, candidates, codes } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        -16
      ],
      "id": "4dc50535-1456-4f80-8a20-08a3e5d7176a",
      "name": "Build candidates",
      "retryOnFail": true,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Description: {{ $json.description }}\n\nCandidate codes:\n{{ $json.candidates }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a medical coding assistant. From the candidate list only, choose up to 3 codes that best match the description, best first. Never use a code that is not in the list. If none fit, return an empty results array. Reply with JSON only, no other text, in this shape: {\"results\":[{\"code\":\"E11621\",\"reason\":\"short reason\"}]}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1200,
        0
      ],
      "id": "6d34b485-db46-4500-8ba8-7b65e126d604",
      "name": "Pick best codes",
      "retryOnFail": true,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "model": "nvidia/nemotron-3.5-lightning:free",
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        1200,
        144
      ],
      "id": "9afe26e4-5d43-485a-a768-0a52d0e56e25",
      "name": "OpenRouter Chat Model1",
      "credentials": {
        "openRouterApi": {
          "id": "ZKf2Gs4YnDNoGslM",
          "name": "OpenRouter account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst clean = raw.replace(/```json|```/g, '').trim();\nlet parsed = { results: [] };\ntry { parsed = JSON.parse(clean); } catch (e) {}\n\nconst lookup = {};\nfor (const i of $('Search ICD-10').all()) lookup[i.json.code] = i.json.description;\n\nconst dot = c => c.length > 3 ? c.slice(0, 3) + '.' + c.slice(3) : c;\n\nconst results = (parsed.results || [])\n  .filter(r => lookup[r.code])\n  .map(r => ({ code: dot(r.code), description: lookup[r.code], reason: r.reason }));\n\nconst input = $('Webhook').first().json.body.description;\nreturn [{ json: {\n  status: results.length ? 'ok' : 'no_match',\n  input,\n  results,\n  note: 'Suggested codes only. Verify against the full clinical documentation and a certified coder before billing.'\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
